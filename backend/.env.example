DEBUG=True
DJANGO_SECRET_KEY=cambia-esta-clave-local-por-una-propia

# Jira Cloud. Create an API token in your Atlassian account; do not reuse tokens from other people.
JIRA_SERVER=https://tu-organizacion.atlassian.net
JIRA_USER=tu-correo@ejemplo.com
JIRA_API_TOKEN=pega-aqui-tu-token-de-jira
JIRA_CURRENT_USER=tu-correo@ejemplo.com

# jira = API de Jira Cloud (recomendado para el chat).
# local = tabla JiraIssue en PostgreSQL (util para pruebas o importacion Excel).
JIRA_DATA_SOURCE=jira

# PostgreSQL local. Usa tu usuario y contrasena; nunca dejes credenciales reales en Git.
DB_NAME=chatbot_db
DB_USER=postgres
DB_PASSWORD=tu-password-local
DB_HOST=localhost
DB_PORT=5432

# Orquestacion del agente. El frontend nunca recibe estas claves.
AGENT_EXECUTION_MODE=local
AGENT_PROVIDER=codex
AGENT_TIMEOUT=900

# Solo si vas a enriquecer reportes con un agente CLI local.
OPENAI_API_KEY=pega-aqui-tu-clave-openai
GEMINI_API_KEY=pega-aqui-tu-clave-gemini
